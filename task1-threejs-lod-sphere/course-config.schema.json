{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "球面知识地图配置",
  "type": "object",
  "required": ["schema", "radius", "courses"],
  "properties": {
    "schema": {
      "const": 4
    },
    "radius": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "courses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/course"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "position": {
      "type": "object",
      "required": ["id", "label", "phi", "psi", "x", "y", "z"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "phi": {
          "type": "number",
          "minimum": -3.141592653589793,
          "maximum": 3.141592653589793
        },
        "psi": {
          "type": "number",
          "minimum": -1.5707963267948966,
          "maximum": 1.5707963267948966
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "regionBase": {
      "type": "object",
      "required": ["id", "title", "vertexIds"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "vertexIds": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "chapter": {
      "allOf": [
        {
          "$ref": "#/$defs/regionBase"
        },
        {
          "type": "object",
          "required": ["sectionIds"],
          "properties": {
            "sectionIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "section": {
      "allOf": [
        {
          "$ref": "#/$defs/regionBase"
        },
        {
          "type": "object",
          "required": ["chapterId", "knowledge"],
          "properties": {
            "chapterId": {
              "type": "string",
              "minLength": 1
            },
            "knowledge": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/position"
              }
            }
          }
        }
      ]
    },
    "course": {
      "type": "object",
      "required": ["id", "title", "color", "vertices", "chapters", "sections"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/position"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
